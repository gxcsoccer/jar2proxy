{
  "name": "jar2proxy",
  "version": "2.0.0",
  "author": "coolme200",
  "keywords": [
    "jar",
    "proxy",
    "typescript",
    "egg"
  ],
  "description": "transfer java facade with jar to js",
  "main": "dist/lib/jar2proxy.js",
  "types": "dist/lib/jar2proxy.d.ts",
  "bin": {
    "jar2proxy": "dist/bin/jar2proxy.js"
  },
  "files": [
    "bin",
    "lib",
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build:java": "./node_modules/mirant/bin/ant -f astparser/build.xml",
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "npm run build && egg-bin test",
    "cov": "egg-bin cov",
    "lint": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "cassandra-map": "^0.1.7",
    "commander": "^12.1.0",
    "copy-to": "^2.0.1",
    "debug": "^4.3.7",
    "egg-utils": "^2.4.1",
    "globby": "^13.2.2",
    "mini-logger": "^1.1.3",
    "nunjucks": "^3.2.4",
    "urllib": "^4.5.1",
    "xml2map": "^1.0.2"
  },
  "devDependencies": {
    "@types/debug": "^4.1.12",
    "@types/node": "^22.10.2",
    "@types/nunjucks": "^3.2.6",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "autod": "^3.0.1",
    "await-event": "^2.1.0",
    "coffee": "^5.5.0",
    "egg-bin": "^4.8.5",
    "enums": "^1.0.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "fs-extra": "^11.2.0",
    "mirant": "^1.9.6",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "license": "MIT"
}
